# 后端本地/部署配置示例
# 复制为 .env 并按实际环境修改；不要把真实密码提交到仓库。

# 生产数据库（默认 MariaDB）
DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=xbf
DB_PASSWORD=<由部署环境注入>
DB_NAME=lucky_ball

# 仅在 DB_TYPE=sqlite 时使用
DB_PATH=backend/data/draws.db

# 服务配置
CORS_ORIGINS=http://localhost:5173,https://hotpotcloud.github.io
LOG_LEVEL=INFO
TOKEN_TTL_HOURS=12

# 初始管理员账号（仅在用户表为空时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=888888

# 启动时是否尝试从官方接口刷新数据
REFRESH_ON_STARTUP=0

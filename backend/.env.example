# 后端运行配置模板
# 使用方式：把本文件复制到服务器的 /opt/lucky-picks/backend/.env 并填写真实值。
# 注意：本文件不要提交到仓库；密码只写在服务器本地。

# ---- 数据库（MariaDB） ----
DB_TYPE=mariadb
DB_HOST=119.29.189.103
DB_PORT=3306
DB_USER=xbf
DB_PASSWORD=填写数据库密码
DB_NAME=lucky_ball

# ---- 服务 ----
API_PORT=1688
CORS_ORIGINS=https://hotpotcloud.github.io,http://localhost:5173
LOG_LEVEL=INFO
TOKEN_TTL_HOURS=12

# ---- 初始管理员账号（仅当用户表为空时创建） ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=888888
